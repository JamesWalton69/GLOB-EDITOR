Copy to `.env.local` and fill in from your Appwrite console. See APPWRITE_SETUP.md.

# Appwrite project
VITE_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=your-project-id
VITE_APPWRITE_BUCKET_ID=your-bucket-id

# Function ID of functions/compiler — holds the compiler API keys server-side
VITE_APPWRITE_FUNCTION_ID=compiler

# Admin identities allowed to view every workspace (leave blank to disable master view)
VITE_APPWRITE_ADMIN_USER_ID=
VITE_APPWRITE_ADMIN_EMAILS=admin@example.com
